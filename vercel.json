{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --cwd slides --frozen-lockfile",
  "buildCommand": "bun run --cwd slides build",
  "outputDirectory": "slides/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
